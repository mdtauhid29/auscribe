# ElevenLabs API Key (Get yours at https://elevenlabs.io)
# Note: You can also enter the API key directly in the AuScribe web interface!
ELEVENLABS_API_KEY=your_api_key_here

# Server Port (Default: 5000)
PORT=5000

# Server Host (Default: 0.0.0.0 allows access from Android phone on local network)
HOST=0.0.0.0
